# deploy/vps-ai-pbx — bootstrap environment.
#
# This file is BOOTSTRAP (platform-level) configuration only — per
# ARCHITECTURE.md §4a. It intentionally does NOT include per-customer
# telephony credentials as a scaling pattern: the SIP_GATEWAY_* block below
# is a single trunk for this initial deployment, not a template to repeat
# per tenant. Future customer gateways belong in Postgres
# (telephony_configurations), provisioned through the app — see
# ARCHITECTURE.md §4b ("Future Configuration Service").
#
# Copy this file to .env and fill in every value below. Never commit .env.

# ============================================================================
# FreeSWITCH bootstrap networking
# ============================================================================

# This VPS's real, public IPv4 address. Do NOT use a private/LAN IP here —
# unlike the Raspberry Pi this stack migrates from (which has no public IP
# and relies on NAT traversal), a VPS has one, and FreeSWITCH needs it
# verbatim for SIP/RTP to work with any real SIP trunk.
SIP_EXTERNAL_IP=

# Usually identical to SIP_EXTERNAL_IP unless your VPS provider gives you a
# separate address for media vs. signaling (uncommon — leave equal to
# SIP_EXTERNAL_IP if unsure).
RTP_PUBLIC_IP=

# Only change if your SIP trunk requires a non-standard port.
SIP_EXTERNAL_PORT=5060
SIP_EXTERNAL_TLS_PORT=5061

# RTP media port range actually published on the host (docker-compose.vps.yml)
# AND configured inside FreeSWITCH (docker-entrypoint.sh) — the two must
# always match, which is why both read these same two vars. Deliberately
# NOT the Raspberry Pi's full compiled-in default (16384-32768, ~16k ports):
# publishing that many individual UDP ports through Docker's bridge network
# is impractically slow to start. 200 ports supports roughly 100 concurrent
# two-way audio calls — plenty for this single-tenant bootstrap deployment.
# Widen only if real concurrent-call volume needs it.
RTP_PORT_RANGE_START=20000
RTP_PORT_RANGE_END=20199

# ============================================================================
# ESL (Event Socket Library) — internal only, never exposed on the host.
# See VPS_FIREWALL.md: 8021 is never published; freeswitch-manager reaches
# it over the internal Docker network by service name.
# ============================================================================

# Set to a strong, random value — never ClueCon (FreeSWITCH's well-known
# default). e.g.: openssl rand -hex 24
ESL_PASSWORD=

# Comma-separated CIDR allow-list for FreeSWITCH's own ESL ACL (defense in
# depth on top of ESL never being host-published — see VPS_FIREWALL.md).
# Must include the Docker bridge subnet docker-compose.vps.yml's
# ai-pbx-network actually uses so freeswitch-manager can connect; check
# `docker network inspect ai-pbx-network` if unsure, or leave the default
# below, which matches Compose's typical default bridge allocation.
DOGRAH_ESL_ALLOWED_CIDRS=172.20.0.0/16

# ============================================================================
# Bootstrap SIP trunk — single trunk for THIS deployment only.
# Do not extend this pattern per-customer (see the header note above).
# ============================================================================

SIP_GATEWAY_NAME=
SIP_GATEWAY_USERNAME=
SIP_GATEWAY_PASSWORD=
SIP_GATEWAY_REALM=
SIP_GATEWAY_PROXY=

# ============================================================================
# Public addressing — same convention as the existing docker-compose.yaml
# (api/constants.py derives BACKEND_API_ENDPOINT/MINIO_PUBLIC_ENDPOINT/
# TURN_HOST from these when unset). AI_BACKEND_URL is what
# docker-compose.vps.yml maps to the existing BACKEND_API_ENDPOINT var
# (docker-compose.vps.yml falls back to it automatically) — set
# AI_BACKEND_URL here; only set BACKEND_API_ENDPOINT too if you need it to
# differ from AI_BACKEND_URL for some reason.
# ============================================================================

PUBLIC_BASE_URL=
PUBLIC_HOST=
AI_BACKEND_URL=

# ============================================================================
# App stack — identical contract to the existing docker-compose.yaml
# (see DOGRAH_CURRENT_ARCHITECTURE.md). Reused as-is, not renamed.
# ============================================================================

POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Required — no default. Generate with: openssl rand -hex 32
OSS_JWT_SECRET=

# Set only if you're running a named Cloudflare tunnel (stable hostname).
# Leave empty for an ephemeral quick tunnel (fine for initial testing, not
# for production — see VPS_DEPLOYMENT_GUIDE.md).
CLOUDFLARE_TUNNEL_TOKEN=

# Number of uvicorn worker processes for the api service.
FASTAPI_WORKERS=1
